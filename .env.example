# Copy to .env and fill only the provider you intend to use. Never commit .env.
# dev.ps1 and docker compose choose this provider; no automatic provider fallback.
LLM_PROVIDER=kimi

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=low
KIMI_MAX_COMPLETION_TOKENS=4096
KIMI_MAX_TOOL_ROUNDS=6
KIMI_TIMEOUT_SECONDS=90

# OpenAI is dormant until explicitly selected. No API request is made to check balance.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Provider profiles default to local lexical knowledge retrieval, with no embedding API.
APP_VECTOR_BACKEND=lexical
RAG_SCORE_THRESHOLD=0.15
# Optional OpenAI embedding (configure and authorize separately):
# EMBEDDING_PROVIDER=openai
# APP_VECTOR_BACKEND=simple
# OPENAI_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

MCP_ENABLED=false
SESSION_WINDOW_SIZE=10
RAG_TOP_K=5
ROUTE_CONFIDENCE_THRESHOLD=0.55

# Optional encrypted credentials entered through the resource UI.
# Supply a separately backed-up 32-byte random Base64 master key; never commit a real value.
APP_RESOURCE_MASTER_KEY=
APP_RESOURCES_ALLOWED_CREDENTIAL_ENV=KIMI_API_KEY,OPENAI_API_KEY,OPENAI_EMBEDDING_API_KEY
