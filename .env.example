LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini
# 可选：多模态单独指定；不设则与 LLM_MODEL 相同（当前实现回落主模型）
# VISION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Spring AI 绑定（一般与 LLM_* 一致；BASE_URL 通常不含 /v1）
# 注意：多数 dotenv 实现不会展开 ${LLM_API_KEY}；请写成与上面相同的实际值，
# 或仅依赖 application.yml 的回落：SPRING_AI_OPENAI_* ← LLM_*。
SPRING_AI_OPENAI_API_KEY=sk-your-key
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com

MCP_ENABLED=true
SESSION_WINDOW_SIZE=10
RAG_TOP_K=5
ROUTE_CONFIDENCE_THRESHOLD=0.55
